{$ORVO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	handle_path /otlp/* {
		@preflight method OPTIONS
		header Access-Control-Allow-Origin https://orvo-chat.decie.dev
		header Access-Control-Allow-Methods "POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, traceparent, x-api-key"
		respond @preflight 204
		reverse_proxy orvo-app:4318
	}
	reverse_proxy orvo-app:8080
}

{$CHAT_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy orvo-example-chat-api:5001
}
