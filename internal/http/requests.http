### Auth & Organization API Requests
### Use these with VS Code REST Client extension or similar

@baseUrl = http://localhost:3000/api
@token = YOUR_SESSION_TOKEN_HERE

### ===================== AUTH ===================== ###

### Register a new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123",
  "name": "Test User"
}

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Get current session (requires auth)
GET {{baseUrl}}/auth/session
Authorization: Bearer {{token}}

### Refresh session
POST {{baseUrl}}/auth/session/refresh
Authorization: Bearer {{token}}

### List all sessions
GET {{baseUrl}}/auth/sessions
Authorization: Bearer {{token}}

### Revoke a specific session
DELETE {{baseUrl}}/auth/sessions/ses_XXXXX
Authorization: Bearer {{token}}

### Revoke all sessions
DELETE {{baseUrl}}/auth/sessions
Authorization: Bearer {{token}}

### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

### Set active organization
POST {{baseUrl}}/auth/session/active-organization
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "organization_id": "org_XXXXX"
}

### Unset active organization
POST {{baseUrl}}/auth/session/active-organization
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "organization_id": null
}

### ===================== ORGANIZATIONS ===================== ###

### Check if slug is available
POST {{baseUrl}}/organizations/check-slug
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "slug": "my-org"
}

### Create organization
POST {{baseUrl}}/organizations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "My Organization",
  "slug": "my-org",
  "logo": "https://example.com/logo.png"
}

### List user's organizations
GET {{baseUrl}}/organizations
Authorization: Bearer {{token}}

### Get organization by ID
GET {{baseUrl}}/organizations/org_XXXXX
Authorization: Bearer {{token}}

### Update organization
PATCH {{baseUrl}}/organizations/org_XXXXX
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Organization Name"
}

### Delete organization (owner only)
DELETE {{baseUrl}}/organizations/org_XXXXX
Authorization: Bearer {{token}}

### Leave organization
POST {{baseUrl}}/organizations/org_XXXXX/leave
Authorization: Bearer {{token}}

### ===================== MEMBERS ===================== ###

### List organization members
GET {{baseUrl}}/organizations/org_XXXXX/members
Authorization: Bearer {{token}}

### Add member directly (admin/owner only)
POST {{baseUrl}}/organizations/org_XXXXX/members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "user_id": "usr_XXXXX",
  "role": "member"
}

### Update member role
PATCH {{baseUrl}}/organizations/org_XXXXX/members/mem_XXXXX/role
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "admin"
}

### Remove member
DELETE {{baseUrl}}/organizations/org_XXXXX/members/mem_XXXXX
Authorization: Bearer {{token}}

### ===================== INVITATIONS ===================== ###

### List organization invitations
GET {{baseUrl}}/organizations/org_XXXXX/invitations
Authorization: Bearer {{token}}

### Create invitation
POST {{baseUrl}}/organizations/org_XXXXX/invitations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "invited@example.com",
  "role": "member"
}

### Cancel invitation
DELETE {{baseUrl}}/organizations/org_XXXXX/invitations/inv_XXXXX
Authorization: Bearer {{token}}

### List user's pending invitations
GET {{baseUrl}}/invitations
Authorization: Bearer {{token}}

### Accept invitation
POST {{baseUrl}}/invitations/inv_XXXXX/accept
Authorization: Bearer {{token}}

### Reject invitation
POST {{baseUrl}}/invitations/inv_XXXXX/reject
Authorization: Bearer {{token}}
